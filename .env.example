COMPOSE_PROJECT_NAME=ripe-monitoring
APP_IMAGE=ripe-monitoring-app:local
BIND_ADDRESS=127.0.0.1
POSTGRES_DB=ripe_monitoring
POSTGRES_USER=ripe
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_PORT=5432
CLICKHOUSE_USER=ripe
CLICKHOUSE_PASSWORD=replace_with_different_random_hex_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
NIFI_USERNAME=admin
NIFI_PASSWORD=replace_with_random_password_at_least_12_characters
NIFI_PORT=8443
KAFKA_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_UI_PORT=8080
ADMINER_PORT=8081
BACKFILL_MINUTES=60
